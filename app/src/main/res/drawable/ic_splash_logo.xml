        android:strokeColor="#1A1A24"
        android:strokeWidth="2"
        android:pathData="M60,60 m-50,0 a50,50 0 1,0 100,0 a50,50 0 1,0 -100,0" />

    <!-- Lettre "N" stylisee (les 3 barres du N geometrique) -->
    <!-- Barre gauche -->
    <path
        android:fillColor="#C9A84C"
        android:pathData="M40,40 L48,40 L48,80 L40,80 Z" />
    <!-- Barre droite -->
    <path
        android:fillColor="#C9A84C"
        android:pathData="M72,40 L80,40 L80,80 L72,80 Z" />
    <!-- Diagonale (du haut-gauche au bas-droite) -->
    <path
        android:fillColor="#C9A84C"
        android:pathData="M48,40 L52,40 L72,80 L68,80 Z" />

    <!-- 3 petites etoiles (constellation) en haut a droite -->
    <path
        android:fillColor="#2D44CC"
        android:pathData="M88,30 m-2,0 a2,2 0 1,0 4,0 a2,2 0 1,0 -4,0" />
    <path
        android:fillColor="#2D44CC"
        android:pathData="M96,38 m-1.5,0 a1.5,1.5 0 1,0 3,0 a1.5,1.5 0 1,0 -3,0" />
    <path
        android:fillColor="#2D44CC"
        android:pathData="M85,42 m-1,0 a1,1 0 1,0 2,0 a1,1 0 1,0 -2,0" />
