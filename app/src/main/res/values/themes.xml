<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Theme principal de l'app (apres le splash, applique par Compose via NovaAtlasTheme).
         On laisse le parent Material standard, Compose override tout. -->
    <style name="Theme.NovaAtlas" parent="android:Theme.Material.NoActionBar">
        <!-- Pas de titre natif Android en haut (sinon affiche "NovaAtlas" en blanc
             par-dessus notre header Compose) -->
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:statusBarColor">@color/nova_bg_0</item>
        <item name="android:navigationBarColor">@color/nova_bg_0</item>
        <item name="android:windowBackground">@color/nova_bg_0</item>
    </style>

    <!-- Theme pour le splash screen (avant le splash Compose).
         Doit avoir un parent SplashScreen pour que l'API marche.
         On definit la couleur de fond + l'icone + le texte. -->
    <style name="Theme.NovaAtlas.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/nova_bg_0</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:statusBarColor">@color/nova_bg_0</item>
        <item name="android:navigationBarColor">@color/nova_bg_0</item>
        <item name="android:windowBackground">@color/nova_bg_0</item>
    </style>
</resources>
